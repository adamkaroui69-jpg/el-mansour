<Window x:Class="ElMansourSyndicManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:ElMansourSyndicManager.Views"
        xmlns:viewmodels="clr-namespace:ElMansourSyndicManager.ViewModels"
        xmlns:converters="clr-namespace:ElMansourSyndicManager.Converters"
        mc:Ignorable="d"
        Title="El Mansour Syndic Manager"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/Assets/logo.png"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:NotificationBackgroundConverter x:Key="NotificationBackgroundConverter"/>
        
        <!-- Style de Navigation Moderne -->
        <Style x:Key="ModernNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="16,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Indicateur de sélection (Glow) -->
                                <Border x:Name="SelectionIndicator" 
                                        Grid.Column="0"
                                        Width="4" Height="24" 
                                        CornerRadius="2"
                                        Background="{DynamicResource PrimaryBrush}"
                                        HorizontalAlignment="Left"
                                        Margin="-20,0,0,0"
                                        Opacity="0">
                                </Border>
                                
                                <ContentPresenter Grid.ColumnSpan="2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1010B981"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="SelectionIndicator" Property="Background" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fond Global avec Glows -->
    <Grid>


        <materialDesign:DrawerHost x:Name="DrawerHost"
                                  IsLeftDrawerOpen="True"
                                  OpenMode="Standard">
            
            <!-- Menu Latéral (Solide) -->
            <materialDesign:DrawerHost.LeftDrawerContent>
                <Grid Width="280">
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <!-- En-tête du Menu -->
                            <StackPanel DockPanel.Dock="Top" Margin="30,50,30,40">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Image Source="/Assets/logo.png" Width="40" Height="40" Margin="0,0,15,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="El Mansour" 
                                                 FontSize="20" 
                                                 FontWeight="Bold" 
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Syndic Manager" 
                                                 FontSize="12" 
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Profil Utilisateur (Bas de page) -->
                            <Border DockPanel.Dock="Bottom" Margin="20,0,20,30" Padding="15" Background="#10FFFFFF" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#10B981">
                                        <TextBlock Text="{Binding CurrentUser.Username, Converter={StaticResource StringToInitialsConverter}}" 
                                                 Foreground="White" 
                                                 FontWeight="Bold" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUser.Username}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentUser.Role}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    
                                    <materialDesign:PopupBox Grid.Column="2" PlacementMode="TopAndAlignRightEdges" StaysOpen="False" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <StackPanel Width="150">
                                            <Button Command="{Binding LogoutCommand}" Content="Déconnexion" />
                                        </StackPanel>
                                    </materialDesign:PopupBox>
                                </Grid>
                            </Border>

                            <!-- Liste de Navigation -->
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <ListBox x:Name="NavigationListBox"
                                        ItemsSource="{Binding NavigationItems}"
                                        SelectionMode="Single"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        SelectedItem="{Binding SelectedNavigationItem}"
                                        ItemContainerStyle="{StaticResource ModernNavItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                       Width="20" Height="20" 
                                                                       Margin="0,0,16,0"
                                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" 
                                                         FontSize="15"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </materialDesign:DrawerHost.LeftDrawerContent>

            <!-- Contenu Principal -->
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barre Supérieure Transparente -->
                <Grid Grid.Row="0" Margin="30,20,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bouton Hamburger -->
                    <ToggleButton Grid.Column="0"
                                 Style="{StaticResource MaterialDesignHamburgerToggleButton}"
                                 IsChecked="{Binding ElementName=DrawerHost, Path=IsLeftDrawerOpen}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Width="24" Height="24"
                                 Margin="0,0,20,0"/>

                    <!-- Titre de la page active -->
                    <TextBlock Grid.Column="1"
                              Text="{Binding SelectedNavigationItem.Title}"
                              FontSize="24"
                              FontWeight="Bold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center">
                    </TextBlock>

                    <!-- Actions (Theme & Notifications) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Theme Toggle -->
                        <Button Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Changer le thème"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Margin="0,0,16,0">
                            <materialDesign:PackIcon Width="24" Height="24">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
                                        <Setter Property="Kind" Value="WeatherSunny" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Kind" Value="WeatherNight" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>


                        <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" StaysOpen="False">
                            <materialDesign:PopupBox.ToggleContent>
                                <Grid Cursor="Hand">
                                    <Border Background="{DynamicResource BorderSubtleBrush}" CornerRadius="12" Width="40" Height="40">
                                        <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#EF4444" CornerRadius="6" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                            Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </materialDesign:PopupBox.ToggleContent>
                            
                            <!-- Popup de Notifications Moderne -->
                            <Border Background="{DynamicResource CardBrush}" 
                                    CornerRadius="16" 
                                    Width="380" 
                                    MaxHeight="500"
                                    Margin="10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30000000" BlurRadius="30" ShadowDepth="0" Opacity="0.15"/>
                                </Border.Effect>
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- En-tête Moderne -->
                                    <Border Grid.Row="0" 
                                            Background="#10B981" 
                                            CornerRadius="16,16,0,0" 
                                            Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <materialDesign:PackIcon Grid.Column="0" 
                                                                    Kind="Bell" 
                                                                    Width="24" 
                                                                    Height="24" 
                                                                    Foreground="White" 
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,12,0"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                      Text="Notifications" 
                                                      Foreground="White" 
                                                      FontWeight="Bold" 
                                                      FontSize="18"
                                                      VerticalAlignment="Center"/>
                                            
                                            <Border Grid.Column="2" 
                                                   Background="#20FFFFFF" 
                                                   CornerRadius="12" 
                                                   Padding="10,6"
                                                   Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding NotificationCount}" 
                                                          Foreground="White" 
                                                          FontWeight="SemiBold" 
                                                          FontSize="13"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Contenu des Notifications -->
                                    <ScrollViewer Grid.Row="1" 
                                                 VerticalScrollBarVisibility="Auto" 
                                                 MaxHeight="400"
                                                 Padding="0">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Notifications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                               BorderThickness="0,0,0,1" 
                                                               Padding="20,16"
                                                               Background="Transparent">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Icône de notification -->
                                                                <Border Grid.Column="0" 
                                                                       Width="40" 
                                                                       Height="40" 
                                                                       CornerRadius="10" 
                                                                       Background="#2010B981"
                                                                       Margin="0,0,12,0">
                                                                    <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                                            Width="20" 
                                                                                            Height="20" 
                                                                                            Foreground="#10B981" 
                                                                                            HorizontalAlignment="Center" 
                                                                                            VerticalAlignment="Center"/>
                                                                </Border>
                                                                
                                                                <!-- Contenu de la notification -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" 
                                                                              FontWeight="SemiBold" 
                                                                              FontSize="14"
                                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                                              TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Message}" 
                                                                              FontSize="13" 
                                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                                              TextWrapping="Wrap"
                                                                              Margin="0,4,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                            <!-- Message si aucune notification -->
                                            <Border Padding="40,60" 
                                                   Visibility="{Binding HasNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="BellOff" 
                                                                            Width="48" 
                                                                            Height="48" 
                                                                            Foreground="{DynamicResource BorderBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            Margin="0,0,0,16"/>
                                                    <TextBlock Text="Aucune nouvelle notification" 
                                                              Foreground="{DynamicResource TextSecondaryBrush}" 
                                                              FontSize="14"
                                                              HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </materialDesign:PopupBox>
                    </StackPanel>
                </Grid>

                <!-- Zone de Contenu Dynamique -->
                <materialDesign:TransitioningContent Grid.Row="1"
                               Content="{Binding CurrentView}"
                               Margin="30,10,30,30">
                    <materialDesign:TransitioningContent.OpeningEffect>
                        <materialDesign:TransitionEffect Kind="FadeIn" Duration="0:0:0.4"/>
                    </materialDesign:TransitioningContent.OpeningEffect>
                </materialDesign:TransitioningContent>

                <!-- Global Snackbar -->
                <materialDesign:Snackbar MessageQueue="{Binding MessageQueue}" Grid.Row="1" />
            </Grid>
        </materialDesign:DrawerHost>
    </Grid>
</Window>
