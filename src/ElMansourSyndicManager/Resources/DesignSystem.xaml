<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- CHARTE GRAPHIQUE - EL MANSOUR SYNDIC MANAGER                                     -->
    <!-- Version: 1.0 | Date: 15/01/2026                                                  -->
    <!-- Design System professionnel pour application de gestion de syndic                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 1. COULEURS PRINCIPALES                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Primary (Bleu Professionnel) -->
    <Color x:Key="PrimaryColor">#1976D2</Color>
    <Color x:Key="PrimaryLightColor">#42A5F5</Color>
    <Color x:Key="PrimaryDarkColor">#1565C0</Color>
    <Color x:Key="PrimaryDarkerColor">#0D47A1</Color>
    
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    
    <!-- Secondary (Émeraude Élégant) -->
    <Color x:Key="SecondaryColor">#00897B</Color>
    <Color x:Key="SecondaryLightColor">#26A69A</Color>
    <Color x:Key="SecondaryDarkColor">#00796B</Color>
    
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{StaticResource SecondaryLightColor}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDarkColor}"/>
    
    <!-- Accent (Orange Discret) -->
    <Color x:Key="AccentColor">#FF6F00</Color>
    <Color x:Key="AccentLightColor">#FF8F00</Color>
    <Color x:Key="AccentDarkColor">#E65100</Color>
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 2. MODE SOMBRE (Recommandé pour usage prolongé)                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Backgrounds -->
    <Color x:Key="DarkSurfaceColor">#1E1E1E</Color>
    <Color x:Key="DarkCardColor">#2D2D2D</Color>
    <Color x:Key="DarkElevatedColor">#383838</Color>
    <Color x:Key="DarkDialogColor">#424242</Color>
    
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurfaceColor}"/>
    <SolidColorBrush x:Key="DarkCardBrush" Color="{StaticResource DarkCardColor}"/>
    <SolidColorBrush x:Key="DarkElevatedBrush" Color="{StaticResource DarkElevatedColor}"/>
    <SolidColorBrush x:Key="DarkDialogBrush" Color="{StaticResource DarkDialogColor}"/>
    
    <!-- Textes Mode Sombre -->
    <Color x:Key="DarkPrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="DarkSecondaryTextColor">#B3B3B3</Color>
    <Color x:Key="DarkDisabledTextColor">#666666</Color>
    <Color x:Key="DarkHintTextColor">#808080</Color>
    
    <SolidColorBrush x:Key="DarkPrimaryTextBrush" Color="{StaticResource DarkPrimaryTextColor}"/>
    <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="{StaticResource DarkSecondaryTextColor}"/>
    <SolidColorBrush x:Key="DarkDisabledTextBrush" Color="{StaticResource DarkDisabledTextColor}"/>
    <SolidColorBrush x:Key="DarkHintTextBrush" Color="{StaticResource DarkHintTextColor}"/>
    
    <!-- Dividers & Borders Mode Sombre -->
    <Color x:Key="DarkDividerColor">#404040</Color>
    <Color x:Key="DarkBorderColor">#4A4A4A</Color>
    
    <SolidColorBrush x:Key="DarkDividerBrush" Color="{StaticResource DarkDividerColor}"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorderColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 3. MODE CLAIR                                                                     -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Backgrounds -->
    <Color x:Key="LightSurfaceColor">#FAFAFA</Color>
    <Color x:Key="LightCardColor">#FFFFFF</Color>
    <Color x:Key="LightElevatedColor">#F5F5F5</Color>
    <Color x:Key="LightDialogColor">#FFFFFF</Color>
    
    <SolidColorBrush x:Key="LightSurfaceBrush" Color="{StaticResource LightSurfaceColor}"/>
    <SolidColorBrush x:Key="LightCardBrush" Color="{StaticResource LightCardColor}"/>
    <SolidColorBrush x:Key="LightElevatedBrush" Color="{StaticResource LightElevatedColor}"/>
    <SolidColorBrush x:Key="LightDialogBrush" Color="{StaticResource LightDialogColor}"/>
    
    <!-- Textes Mode Clair -->
    <Color x:Key="LightPrimaryTextColor">#212121</Color>
    <Color x:Key="LightSecondaryTextColor">#757575</Color>
    <Color x:Key="LightDisabledTextColor">#BDBDBD</Color>
    <Color x:Key="LightHintTextColor">#9E9E9E</Color>
    
    <SolidColorBrush x:Key="LightPrimaryTextBrush" Color="{StaticResource LightPrimaryTextColor}"/>
    <SolidColorBrush x:Key="LightSecondaryTextBrush" Color="{StaticResource LightSecondaryTextColor}"/>
    <SolidColorBrush x:Key="LightDisabledTextBrush" Color="{StaticResource LightDisabledTextColor}"/>
    <SolidColorBrush x:Key="LightHintTextBrush" Color="{StaticResource LightHintTextColor}"/>
    
    <!-- Dividers & Borders Mode Clair -->
    <Color x:Key="LightDividerColor">#E0E0E0</Color>
    <Color x:Key="LightBorderColor">#BDBDBD</Color>
    
    <SolidColorBrush x:Key="LightDividerBrush" Color="{StaticResource LightDividerColor}"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="{StaticResource LightBorderColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 4. COULEURS SÉMANTIQUES                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Succès (Vert) -->
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="SuccessLightColor">#81C784</Color>
    <Color x:Key="SuccessDarkColor">#388E3C</Color>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource SuccessDarkColor}"/>
    
    <!-- Erreur (Rouge) -->
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="ErrorLightColor">#E57373</Color>
    <Color x:Key="ErrorDarkColor">#D32F2F</Color>
    
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorLightBrush" Color="{StaticResource ErrorLightColor}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ErrorDarkColor}"/>
    
    <!-- Avertissement (Orange) -->
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="WarningLightColor">#FFB74D</Color>
    <Color x:Key="WarningDarkColor">#F57C00</Color>
    
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource WarningDarkColor}"/>
    
    <!-- Information (Bleu Clair) -->
    <Color x:Key="InfoColor">#2196F3</Color>
    <Color x:Key="InfoLightColor">#64B5F6</Color>
    <Color x:Key="InfoDarkColor">#1976D2</Color>
    
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}"/>
    <SolidColorBrush x:Key="InfoDarkBrush" Color="{StaticResource InfoDarkColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 5. COULEURS MÉTIER (États Financiers)                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <SolidColorBrush x:Key="PaidBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="PendingBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OverdueBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="AdvancedBrush" Color="{StaticResource InfoColor}"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 6. ESPACEMENT (Système de 8px)                                                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingS">8</Thickness>
    <Thickness x:Key="SpacingM">16</Thickness>
    <Thickness x:Key="SpacingL">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
    <Thickness x:Key="SpacingXXL">48</Thickness>
    
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingXSValue">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingSValue">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingMValue">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingLValue">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingXLValue">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="SpacingXXLValue">48</sys:Double>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 7. BORDER RADIUS                                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <CornerRadius x:Key="RadiusS">4</CornerRadius>
    <CornerRadius x:Key="RadiusM">8</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 8. OMBRES (ELEVATION)                                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <DropShadowEffect x:Key="Elevation1" BlurRadius="3" ShadowDepth="1" Opacity="0.12" Direction="270"/>
    <DropShadowEffect x:Key="Elevation2" BlurRadius="4" ShadowDepth="2" Opacity="0.14" Direction="270"/>
    <DropShadowEffect x:Key="Elevation4" BlurRadius="8" ShadowDepth="4" Opacity="0.16" Direction="270"/>
    <DropShadowEffect x:Key="Elevation6" BlurRadius="12" ShadowDepth="6" Opacity="0.18" Direction="270"/>
    <DropShadowEffect x:Key="Elevation8" BlurRadius="16" ShadowDepth="8" Opacity="0.20" Direction="270"/>
    <DropShadowEffect x:Key="Elevation12" BlurRadius="24" ShadowDepth="12" Opacity="0.22" Direction="270"/>
    <DropShadowEffect x:Key="Elevation16" BlurRadius="32" ShadowDepth="16" Opacity="0.24" Direction="270"/>
    <DropShadowEffect x:Key="Elevation24" BlurRadius="48" ShadowDepth="24" Opacity="0.28" Direction="270"/>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 9. TYPOGRAPHIE                                                                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Tailles de Police -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH1">32</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH2">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH3">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeH4">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBody">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeButton">14</sys:Double>
    
    <!-- Poids de Police -->
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightRegular">Regular</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    <!-- 10. OVERRIDE LEGACY KEYS (Pour compatibilité avec anciennes vues)                -->
    <!-- ═══════════════════════════════════════════════════════════════════════════════ -->
    
    <!-- Override des anciennes clés de ModernStyles.xaml avec les nouvelles couleurs -->
    
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource DarkSurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource DarkCardColor}"/>
    <SolidColorBrush x:Key="CardElevatedBrush" Color="{StaticResource DarkElevatedColor}"/>
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="{StaticResource DarkCardColor}"/>
    
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource DarkPrimaryTextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource DarkSecondaryTextColor}"/>
    
    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorderColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource DarkBorderColor}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource DarkBorderColor}"/>
    
    <!-- Accents - Use new primary colors -->
    <Color x:Key="PrimaryAccent">#1976D2</Color>
    <Color x:Key="SecondaryAccent">#00897B</Color>
    <Color x:Key="TertiaryAccent">#FF6F00</Color>

</ResourceDictionary>
