<UserControl x:Class="ElMansourSyndicManager.Views.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:ElMansourSyndicManager.Converters">
    
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
              Background="#80000000"
              Panel.ZIndex="999">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                            Value="0"
                            IsIndeterminate="True"
                            Width="60" Height="60"/>
                <TextBlock Text="Chargement des données..."
                          Foreground="White"
                          FontSize="16"
                          Margin="0,16,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                
                <!-- Header -->
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Rapports Financiers" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="État des comptes et arriérés" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" 
                               Command="{Binding ExportExcelCommand}"
                               Margin="0,0,8,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" 
                                                            Width="18" Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="EXCEL" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        
                        <Button Style="{StaticResource SecondaryButton}" 
                               Command="{Binding ExportCsvCommand}"
                               Margin="0,0,8,0">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDelimited" 
                                                            Width="18" Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="CSV" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        
                        <Button Style="{StaticResource PrimaryButton}"
                               Command="{Binding RefreshCommand}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" 
                                                            Width="18" Height="18"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"/>
                                    <TextBlock Text="ACTUALISER" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- KPI Cards -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Arriérés -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource KPICard}" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="AlertCircle" 
                                                        Width="24" Height="24"
                                                        Foreground="{StaticResource ErrorBrush}"
                                                        VerticalAlignment="Center"/>
                                <TextBlock Text="Total Arriérés" 
                                          Style="{StaticResource SecondaryText}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalArrears, StringFormat='{}{0:N2} TND'}" 
                                      FontSize="28"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="{Binding ResidentsInArrears, StringFormat='{}{0} résidents'}" 
                                      Style="{StaticResource SecondaryText}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Résidents à Jour -->
                    <materialDesign:Card Grid.Column="1" Style="{StaticResource KPICard}" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="CheckCircle" 
                                                        Width="24" Height="24"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        VerticalAlignment="Center"/>
                                <TextBlock Text="À Jour" 
                                          Style="{StaticResource SecondaryText}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ResidentsUpToDate}" 
                                      FontSize="28"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="résidents" 
                                      Style="{StaticResource SecondaryText}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Résidents en Retard -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource KPICard}" Margin="0,0,16,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="ClockAlert" 
                                                        Width="24" Height="24"
                                                        Foreground="{StaticResource WarningBrush}"
                                                        VerticalAlignment="Center"/>
                                <TextBlock Text="En Retard" 
                                          Style="{StaticResource SecondaryText}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ResidentsInArrears}" 
                                      FontSize="28"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="résidents" 
                                      Style="{StaticResource SecondaryText}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Résidents en Avance -->
                    <materialDesign:Card Grid.Column="3" Style="{StaticResource KPICard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="TrendingUp" 
                                                        Width="24" Height="24"
                                                        Foreground="{StaticResource InfoBrush}"
                                                        VerticalAlignment="Center"/>
                                <TextBlock Text="En Avance" 
                                          Style="{StaticResource SecondaryText}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ResidentsInAdvance}" 
                                      FontSize="28"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource InfoBrush}"/>
                            <TextBlock Text="résidents" 
                                      Style="{StaticResource SecondaryText}"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- Filters -->
                <materialDesign:Card Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                materialDesign:HintAssist.Hint="Rechercher un résident..."
                                Style="{StaticResource ProfessionalTextBox}"
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,16,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadDataCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" 
                               Content="RECHERCHER" 
                               Style="{StaticResource PrimaryButton}"
                               Command="{Binding LoadDataCommand}"/>
                    </Grid>
                </materialDesign:Card>

                <!-- DataGrid -->
                <materialDesign:Card Padding="0">
                    <DataGrid Style="{StaticResource ProfessionalDataGrid}"
                             ItemsSource="{Binding ResidentsFinancialState}"
                             SelectedItem="{Binding SelectedResident}">
                        
                        <DataGrid.Columns>
                            <!-- Code Maison -->
                            <DataGridTextColumn Header="Code Maison" 
                                               Binding="{Binding HouseCode}"
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Propriétaire -->
                            <DataGridTextColumn Header="Propriétaire" 
                                               Binding="{Binding OwnerName}"
                                               Width="*"/>

                            <!-- Total Dû -->
                            <DataGridTextColumn Header="Total Dû" 
                                               Binding="{Binding TotalDue, StringFormat='{}{0:N2} TND'}"
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Total Payé -->
                            <DataGridTextColumn Header="Total Payé" 
                                               Binding="{Binding TotalPaid, StringFormat='{}{0:N2} TND'}"
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Solde -->
                            <DataGridTextColumn Header="Solde" 
                                               Binding="{Binding Balance, StringFormat='{}{0:N2} TND'}"
                                               Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Balance, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Balance, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Mois Impayés -->
                            <DataGridTextColumn Header="Mois Impayés" 
                                               Binding="{Binding UnpaidMonthsCount}"
                                               Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnpaidMonthsCount, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Statut -->
                            <DataGridTemplateColumn Header="Statut" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Orange">
                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Red">
                                                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Blue">
                                                            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusColor}" 
                                                      Foreground="White" 
                                                      FontSize="12"
                                                      FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
