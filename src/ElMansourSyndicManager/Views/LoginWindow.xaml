<Window x:Class="ElMansourSyndicManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="El Mansour Syndic Manager - Connexion"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown"
        Icon="/Assets/logo.png">
    
    <Window.Resources>
        <!-- Animation Fade In -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <!-- Container Principal avec Coins Arrondis -->
    <Border CornerRadius="16" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Côté Gauche (Bleu) -->
                <ColumnDefinition Width="*"/>
                <!-- Côté Droit (Blanc) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- CÔTÉ GAUCHE - BLEU AVEC BRANDING           -->
            <!-- ========================================== -->
            <Grid Grid.Column="0" Background="#4F46E5">
                <!-- Motif Géométrique Subtil -->
                <Canvas>
                    <!-- Rectangles en diagonale pour le motif -->
                    <Rectangle Width="300" Height="300" Fill="#5B52ED" Opacity="0.3" 
                               Canvas.Left="100" Canvas.Top="50" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="15"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="250" Height="250" Fill="#6B62F5" Opacity="0.2" 
                               Canvas.Left="150" Canvas.Top="100" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="15"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>

                <!-- Contenu Centré -->
                <StackPanel VerticalAlignment="Center" Margin="80,0">
                    <!-- Logo Astérisque -->
                    <Viewbox Width="80" Height="80" Margin="0,0,0,40">
                        <Canvas Width="100" Height="100">
                            <!-- Astérisque stylisé -->
                            <Path Fill="White" Data="M50,10 L55,45 L90,45 L62,65 L75,95 L50,75 L25,95 L38,65 L10,45 L45,45 Z"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Titre Principal -->
                    <TextBlock Text="Bienvenue"
                               FontSize="56" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               TextAlignment="Left" 
                               Margin="0,0,0,10"/>

                    <!-- Description -->
                    <TextBlock Text="Gérez votre résidence en toute simplicité. Automatisez vos tâches et gagnez du temps !"
                               FontSize="16"
                               Foreground="#E0E7FF"
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Margin="0,0,0,60"/>

                    <!-- Copyright -->
                    <TextBlock Text="© 2024 El Mansour Syndic. All rights reserved."
                               FontSize="13"
                               Foreground="#A5B4FC"
                               VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- CÔTÉ DROIT - BLANC AVEC FORMULAIRE         -->
            <!-- ========================================== -->
            <Grid Grid.Column="1" Background="White">
                <!-- Bouton Fermer -->
                <Button Style="{StaticResource MaterialDesignIconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="20"
                        Foreground="#6B7280"
                        Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>

                <!-- Formulaire Centré -->
                <StackPanel VerticalAlignment="Center" Margin="80,0" MaxWidth="400">
                    <!-- Titre de l'App -->
                    <TextBlock Text="El Mansour Syndic"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#1F2937"
                               Margin="0,0,0,40"/>



                    <!-- Champ Email/Code Maison -->
                    <TextBox x:Name="HouseCodeTextBox"
                             Text="{Binding HouseCode, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14"
                             Padding="12"
                             Margin="0,0,0,20"
                             BorderBrush="#E5E7EB"
                             BorderThickness="0,0,0,1"
                             Background="Transparent"
                             Foreground="#1F2937"
                             materialDesign:HintAssist.Hint="Code Maison (Ex: A01)"
                             materialDesign:HintAssist.Foreground="#9CA3AF"/>

                    <!-- Champ Password -->
                    <PasswordBox x:Name="PasswordBox"
                                 FontSize="14"
                                 Padding="12"
                                 Margin="0,0,0,30"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="0,0,0,1"
                                 Background="Transparent"
                                 Foreground="#1F2937"
                                 materialDesign:HintAssist.Hint="Code PIN"
                                 materialDesign:HintAssist.Foreground="#9CA3AF"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Bouton Login (Violet) -->
                    <Button Command="{Binding LoginCommand}"
                            Background="#4F46E5"
                            Foreground="White"
                            FontSize="18"
                            FontWeight="Bold"
                            Padding="0,18"
                            Margin="0,10,0,16"
                            BorderThickness="0"
                            Cursor="Hand"
                            Height="56">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="SE CONNECTER" 
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>



                    <!-- Message d'erreur -->
                    <Border Background="#FEE2E2" 
                            CornerRadius="8" 
                            Padding="12"
                            Margin="0,20,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" 
                                                    Foreground="#DC2626"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                      Foreground="#DC2626"
                                      TextWrapping="Wrap"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading -->
                    <ProgressBar IsIndeterminate="True"
                                Height="3"
                                Margin="0,20,0,0"
                                Foreground="#4F46E5"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
