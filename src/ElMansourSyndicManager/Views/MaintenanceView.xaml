<UserControl x:Class="ElMansourSyndicManager.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:ElMansourSyndicManager.ViewModels"
             xmlns:converters="clr-namespace:ElMansourSyndicManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance viewModels:MaintenanceViewModel}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Main Content -->
                <StackPanel Margin="0">
                    <!-- Header -->
                    <Grid Margin="0,0,0,32">
                        <StackPanel>
                            <TextBlock Text="Gestion de la Maintenance" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Suivi des travaux et réparations" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Command="{Binding LoadCommand}" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Content="Actualiser" 
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    Margin="0,0,16,0"
                                    Height="40"/>
                            <Button Command="{Binding CreateCommand}" 
                                    Style="{StaticResource ModernButton}" 
                                    Content="Nouvelle Tâche"
                                    Width="180"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="0">
                        <StackPanel>
                            <Grid Margin="24">
                                <TextBlock Text="Liste des Tâches" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            
                            <DataGrid ItemsSource="{Binding MaintenanceList}" SelectedItem="{Binding SelectedMaintenance}" 
                                      Style="{StaticResource ModernDataGrid}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridHeader}"/>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date Prévue" Binding="{Binding ScheduledDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                                    
                                    <DataGridTemplateColumn Header="Priorité" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                    <Setter Property="Background" Value="#FED7AA"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Priority}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                        <Setter Property="Foreground" Value="#EA580C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTemplateColumn Header="Statut" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="Background" Value="#E0E7FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Foreground" Value="#059669"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Foreground" Value="#4F46E5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="Coût" Binding="{Binding Cost, StringFormat={}{0:N0} TND}" Width="100" FontWeight="Bold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#059669"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTextColumn Header="Assigné à" Binding="{Binding AssignedTo}" Width="120"/>
                                    
                                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}" 
                                                            ToolTip="Modifier"
                                                            Foreground="{StaticResource PrimaryBrush}">
                                                        <materialDesign:PackIcon Kind="Pencil"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignIconButton}" 
                                                            ToolTip="Supprimer (Admin uniquement)"
                                                            Foreground="#EF4444"
                                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <materialDesign:PackIcon Kind="Delete"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Modifier" Command="{Binding UpdateCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Supprimer" Command="{Binding DeleteCommand}" Foreground="Red"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Overlays (Outside ScrollViewer to cover everything) -->
        <!-- Loading Overlay -->
        <Grid Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
        </Grid>

        <!-- Form Overlay -->
        <Grid Background="#B0000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource GlassCard}" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,32"/>

                    <TextBox Text="{Binding FormDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Description" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,24"/>
                    
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Types}" 
                                  SelectedItem="{Binding FormType, Mode=TwoWay}" 
                                  materialDesign:HintAssist.Hint="Type" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Foreground="{StaticResource TextPrimaryBrush}"/>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding Priorities}" 
                                  SelectedItem="{Binding FormPriority, Mode=TwoWay}" 
                                  materialDesign:HintAssist.Hint="Priorité" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding FormCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Coût Estimé (TND)" 
                                 Style="{StaticResource ModernTextBox}"/>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding Statuses}" 
                                  SelectedItem="{Binding FormStatus, Mode=TwoWay}" 
                                  materialDesign:HintAssist.Hint="Statut" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" 
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                    
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker Grid.Column="0" SelectedDate="{Binding FormScheduledDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    materialDesign:HintAssist.Hint="Date Prévue" 
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" 
                                    Foreground="{StaticResource TextPrimaryBrush}"/>

                        <TextBox Grid.Column="2" Text="{Binding FormAssignedTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="Assigné à" 
                                 Style="{StaticResource ModernTextBox}"/>
                    </Grid>

                    <TextBox Text="{Binding FormNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Notes" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,24" 
                             TextWrapping="Wrap" 
                             Height="80"/>

                    <CheckBox IsChecked="{Binding CreateExpense}" 
                              Content="Générer une dépense automatiquement"
                              ToolTip="Cocher pour créer une dépense associée à cette maintenance"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Visibility="{Binding IsEditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              Margin="0,0,0,24"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Command="{Binding CancelCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Content="Annuler" 
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Margin="0,0,16,0"/>
                        <Button Command="{Binding SaveCommand}" 
                                Style="{StaticResource ModernButton}" 
                                Content="Enregistrer"
                                Width="140"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
