<UserControl x:Class="ElMansourSyndicManager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:ElMansourSyndicManager.ViewModels"
             xmlns:converters="clr-namespace:ElMansourSyndicManager.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance viewModels:SettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0">
            <!-- Header -->
            <Grid Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="Paramètres" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Configuration de l'application" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Command="{Binding SaveCommand}" 
                        Style="{StaticResource ModernButton}" 
                        Content="Enregistrer"
                        HorizontalAlignment="Right"
                        Width="160"/>
            </Grid>

            <!-- Appearance Settings -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Apparence" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    <StackPanel>
                        <TextBlock Text="Langue" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Languages}" 
                                  SelectedItem="{Binding SelectedLanguage}" 
                                  materialDesign:HintAssist.Hint="Sélectionner une langue" 
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notifications Settings -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    <StackPanel>
                        <CheckBox IsChecked="{Binding NotificationsEnabled}" 
                                  Content="Activer les notifications" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>
                        <CheckBox IsChecked="{Binding EnableEmailNotifications}" 
                                  Content="Notifications par email" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>
                        <CheckBox IsChecked="{Binding EnablePaymentReminders}" 
                                  Content="Rappels de paiement"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup Settings -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Sauvegardes &amp; Restauration" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    <StackPanel>
                        <CheckBox IsChecked="{Binding AutoBackupEnabled}" 
                                  Content="Activer les sauvegardes automatiques" 
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Fréquence :" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding BackupFrequencies}" 
                                      SelectedItem="{Binding BackupFrequency}"
                                      Width="150"
                                      IsEnabled="{Binding AutoBackupEnabled}"/>
                        </StackPanel>

                        <Button Command="{Binding BackupNowCommand}" 
                                Style="{StaticResource ModernButton}" 
                                Content="Créer une sauvegarde maintenant"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                             <materialDesign:PackIcon Kind="Information" Width="16" Height="16" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                             <TextBlock Text="Les sauvegardes sont stockées dans le dossier 'data/backups'." Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"/>
                        </StackPanel>

                        <TextBlock Text="Historique des sauvegardes" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,24,0,12"/>
                        <DataGrid ItemsSource="{Binding BackupHistory}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" IsReadOnly="True" MaxHeight="200"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  HeadersVisibility="Column"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="150" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <DataGridTextColumn Header="Taille" Binding="{Binding FileSizeDisplay}" Width="100" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <DataGridTemplateColumn Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Content="Restaurer"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Height="25" Padding="8,0" Margin="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Database Configuration -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Base de données (Synchronisation)" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                             <StackPanel Margin="0,0,16,0" Width="150">
                                <TextBlock Text="Type (Provider) :" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DatabaseProvider, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                             </StackPanel>
                             <StackPanel Width="400">
                                <TextBlock Text="Emplacement / Connexion :" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DatabasePath, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                             </StackPanel>
                        </StackPanel>
                        
                        <TextBlock Text="Pour passer en mode CLOUD (Internet) :" 
                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="1. Hébergez une base SQL Server (ex: Azure)." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="2. Changez 'DatabaseProvider' en 'SqlServer' dans appsettings.json." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="3. Mettez votre chaîne de connexion dans 'DefaultConnection'." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="À propos" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Information" Width="24" Height="24" Foreground="{StaticResource InfoBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="El Mansour Syndic Manager" 
                                         FontSize="16" 
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Version : " 
                                             FontSize="14" 
                                             Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AppVersion}" 
                                             FontSize="14" 
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Application de gestion de syndic pour la résidence El Mansour" 
                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 Margin="36,0,0,16"/>
                        
                        <!-- Check for Updates Button -->
                        <StackPanel Margin="36,0,0,16">
                            <Button Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource ModernButton}"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Update" 
                                                           Width="18" 
                                                           Height="18" 
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Vérifier les mises à jour" 
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- Update Status -->
                            <TextBlock Text="{Binding UpdateStatus}" 
                                     Foreground="{StaticResource TextSecondaryBrush}" 
                                     FontSize="12"
                                     Margin="0,8,0,0"
                                     Visibility="{Binding UpdateStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                        
                        <TextBlock Text="© 2024 El Mansour. Tous droits réservés." 
                                 Foreground="{StaticResource TextSecondaryBrush}" 
                                 FontSize="12"
                                 FontStyle="Italic"
                                 Margin="36,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
